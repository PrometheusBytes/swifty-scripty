{% for type in types.protocols where type|annotated:"Injectable" or type.attributes.Injectable %}
{% if not type|annotated:"skipMockCreation" %}

// sourcery:file:{{ type.name }}+TestKey.swift
// swiftlint:disable all
import Foundation
import SwiftyScripty
{% if argument.scriptName != "" %}
{% if argument.scriptName != "SwiftyScripty" %}
import {{ argument.scriptName }}
{% endif %}
{% endif %}

extension {{ type.name }}DependencyKey: {% if argument.skipRetroactive != "true" %}@retroactive {% endif %}InjectionTest {
    public static var testValue: {{ type.name }} = {{ type.name }}Mock()
}

// sourcery:end

{% endif %}
{% endfor %}
